# Local demo credentials - do not reuse elsewhere
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
POSTGRES_PASSWORD=postgres
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Host ports (change here if one is already used on your machine)
KAFKA_EXTERNAL_PORT=29092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPARK_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
MLFLOW_PORT=5000
AIRFLOW_PORT=8082
API_PORT=8000
UI_PORT=8501
KAFKA_UI_PORT=8085

# Single Spark worker. Budget: stream-bronze 1 core/512m (permanent) + one batch job of the DAG 2 cores/1g
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=3g

# Generator: publishes at most MAX_DATA_MB of JSON to Kafka, then stops (no endless real-time stream).
# ~420 bytes/event -> 60 MB is about 150k events; at 100 events/s that takes about 25 minutes.
MAX_DATA_MB=60

# A new model becomes champion unless its AUC is lower than the champion's by more than this
PROMOTION_TOLERANCE=0.01

# Conditional retraining: train only if gold grew by at least this ratio since the last model (0.05 = 5 %)
MIN_NEW_DATA_RATIO=0.05
EVENTS_PER_SEC=100
